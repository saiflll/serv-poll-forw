		{
			"name": "Data Export",
			"item": [
				{
					"name": "Export All Sensors in Area to Excel",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/export/area/s0_13?start=2024-08-01&end=2024-08-20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"export",
								"area",
								"s0_13"
							],
							"query": [
								{
									"key": "start",
									"value": "2024-08-01"
								},
								{
									"key": "end",
									"value": "2024-08-20"
								}
							]
						},
						"description": "Mengekspor semua data sensor (suhu dan RH) dari satu area dalam rentang waktu tertentu ke dalam file Excel (.xlsx). File akan memiliki dua sheet: 'Temperature' dan 'RH'.\n\n- **Path Param**: `area_id` (format `s0_{id}`).\n- **Query Params**: `start` & `end` (YYYY-MM-DD)."
					},
					"response": []
				},
				{
					"name": "Export Single Sensor to Excel",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/export/sensor?area_id=s0_13&sensor_no=1&start_date=2024-08-01&end_date=2024-08-20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"export",
								"sensor"
							],
							"query": [
								{
									"key": "area_id",
									"value": "s0_13"
								},
								{
									"key": "sensor_no",
									"value": "1"
								},
								{
									"key": "start_date",
									"value": "2024-08-01"
								},
								{
									"key": "end_date",
									"value": "2024-08-20"
								}
							]
						},
						"description": "Mengekspor data gabungan (suhu dan RH) dari satu sensor spesifik ke dalam file Excel (.xlsx).\n\n- **Query Params**: `area_id`, `sensor_no`, `start_date`, `end_date`."
					},
					"response": []
				}
			]
		},
