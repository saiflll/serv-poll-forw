		{
			"name": "Device Data Ingestion",
			"item": [
				{
					"name": "Send Sensor Data",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "[\n    {\n        \"ck\": 3,\n        \"area\": 13,\n        \"temp\": [\n            {\n                \"no\": 1,\n                \"ts\": \"2024-08-21T10:00:00.000Z\",\n                \"temp\": 22.5,\n                \"rh\": 55.1\n            },\n            {\n                \"no\": 2,\n                \"ts\": \"2024-08-21T10:00:00.000Z\",\n                \"temp\": 22.6\n            }\n        ],\n        \"door\": [\n            {\n                \"doorid\": 13,\n                \"value\": 1\n            }\n        ]\n    }\n]",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/data",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"data"
							]
						},
						"description": "Endpoint utama untuk perangkat IoT mengirimkan data sensor. Endpoint ini menerima array dari objek data area.\n\n- **Body**: Array dari `AreaData`.\n  - `area`: ID area.\n  - `temp`: Array data sensor suhu/RH. `rh` bersifat opsional.\n  - `door`: Array data sensor pintu/proximity.\n  - `ts` di dalam `temp` harus dalam format RFC3339Nano (contoh: `2024-08-21T10:00:00.123Z`)."
					},
					"response": []
				}
			],
			"auth": {
				"type": "noauth"
			},
			"description": "Endpoint untuk menerima data dari perangkat IoT. Biasanya tidak memerlukan otentikasi JWT."
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
}
